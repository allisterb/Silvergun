<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared with Silvergun.CLI.Tests (linked, not project-referenced): both suites need to corrupt one method
         body identically, and a second copy of the PE offset arithmetic is exactly the kind of duplicate that
         drifts. See tests/Shared/FatHeaderPatcher.cs. -->
    <Compile Include="..\Shared\FatHeaderPatcher.cs" Link="Shared\FatHeaderPatcher.cs" />
    <!-- Shared with Silvergun.PackageAnalysis.NuGet.Tests: the one way a test observes Runtime.Warn, so no test swaps
         the process-global Runtime.logger itself. See tests/Shared/WarningCapture.cs. -->
    <Compile Include="..\Shared\WarningCapture.cs" Link="Shared\WarningCapture.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Silvergun.CodeAnalysis.IL\Silvergun.CodeAnalysis.IL.csproj" />
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.Fixture\Silvergun.CodeAnalysis.IL.Tests.Fixture.csproj" />
    <!-- The matrix fixture is multi-targeted. This normal reference resolves to the best match for THIS
         project (net10.0) and is what typeof(ModernInteropOps) compiles against. -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.MatrixFixture\Silvergun.CodeAnalysis.IL.Tests.MatrixFixture.csproj" />
    <!-- ...but only that best match would be BUILT, so on a clean checkout `dotnet test` here would run the
         TFM matrix tests with no net472 output on disk. This second reference forces the net472 flavour to be
         built as well; ReferenceOutputAssembly="false" keeps it off the compile/runtime reference set (it is
         located by path at test time, never loaded by the host). Every matrix TFM other than this project's
         own needs a line here. -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.MatrixFixture\Silvergun.CodeAnalysis.IL.Tests.MatrixFixture.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      AdditionalProperties="TargetFramework=net472" />
    <!-- The pathological-signature probe (ADR-0021/0022): a plain ProjectReference to an Exe project copies
         its apphost (.exe) into THIS project's output directory, which is what lets the regression test spawn
         it as a child process by path (see ChildProcessProbe / TypedReferencePointerRegressionTests) — the
         same mechanism Silvergun.CLI.Tests uses for the CLI apphost. -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.PathologicalSignatureProbe\Silvergun.CodeAnalysis.IL.Tests.PathologicalSignatureProbe.csproj" />
    <!-- Fixture for the reference-side naming invariant and the self-referential enum
         (docs/agent/measurements/ilspy-provider-spike.md §0.3 and §7). Its assembly is COPIED, never loaded
         from here: once alone into an empty directory so nothing it references resolves, and once with its
         value__ signatures patched into a cycle. typeof(ThreeApis) is only used to locate the file. -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.MetadataShapesFixture\Silvergun.CodeAnalysis.IL.Tests.MetadataShapesFixture.csproj" />
    <!-- Exe, so the plain ProjectReference copies its apphost next to this test assembly and the cyclic-enum
         test can spawn it by path (same mechanism as the PathologicalSignatureProbe above). -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.CyclicEnumProbe\Silvergun.CodeAnalysis.IL.Tests.CyclicEnumProbe.csproj" />
    <!-- Regression fixture for the TAC void-return fix in ext/analysis-net's Disassembler - see
         docs/agent/measurements/tac-platformtypes-spike.md. Also multi-targeted (net472;net10.0), so the
         same "normal reference + forced-build reference" pair as the MatrixFixture entries above is needed:
         the plain reference resolves to THIS project's own TFM (net10.0) for typeof(Widget) to compile
         against, and the second one forces the net472 flavour to be built too. -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.VoidReturnFixture\Silvergun.CodeAnalysis.IL.Tests.VoidReturnFixture.csproj" />
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.VoidReturnFixture\Silvergun.CodeAnalysis.IL.Tests.VoidReturnFixture.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      AdditionalProperties="TargetFramework=net472" />
    <!-- A dozen hand-written ldstr constants (six distinct public IPv4 hosts + two repeats of the first) used
         ONLY by IndicatorAnalysisTruncationTests, to exercise IndicatorAnalysis's injected maxDistinctIndicators
         override against a deterministic, isolated cap boundary. Replaces the deleted
         Silvergun.CodeAnalysis.IL.Tests.BulkIndicatorFixture (10,010 machine-generated constants used to trip
         the real 10,000 cap) now that the cap itself is injectable — see IndicatorCapPayloads.cs for why it is
         still kept as its own (now tiny) assembly rather than folded into the shared fixture. -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.IndicatorCapFixture\Silvergun.CodeAnalysis.IL.Tests.IndicatorCapFixture.csproj" />
    <!-- Capslock-style recall fixtures for the CHA call graph, one namespace per analysis mechanism
         (docs/agent/tasks/capslock-mechanism-fixtures-and-a1.md; ground truth in MechanismGroundTruth.cs).
         net10.0-only and Release-shaped, so a single plain reference suffices; it brings
         ...MechanismFixture.Dependency (the CrossAssembly far side) along transitively, and ...MechanismFixture.HostStubs
         (the MSBuild/Roslyn host-contract stand-ins, reachability R1 S3), which is copied here but NEVER indexed. Both assemblies are
         located BY PATH next to this test assembly and read as metadata - never loaded, so the fixture's module
         initializer and type initializers never run. Its own project so nothing in it moves a pinned
         method-count baseline elsewhere. -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.MechanismFixture\Silvergun.CodeAnalysis.IL.Tests.MechanismFixture.csproj" />
    <!-- The Debug-built mechanism fixture (A2 S2, docs/agent/tasks/cha-a2-dispatch-and-implicit-edges.md §3):
         Optimize forced OFF, so async state machines are CLASSES and their stubs `newobj` them. Same rules as the
         Release fixture above - a plain reference that copies it here, located BY PATH (MechanismFixtureAssemblies)
         and read as metadata, never loaded - and its own namespace root (MechanismFixture.Debug), so it shares one
         MemberIndex with the Release fixture and its Dependency in MechanismGraphSource. -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.MechanismFixture.Debug\Silvergun.CodeAnalysis.IL.Tests.MechanismFixture.Debug.csproj" />
    <!-- Name-shadowing fixture for the A1 member index (review 1, finding C2): it defines its OWN public
         System.Environment and System.IDisposable. A BUILD-ORDER dependency only: ReferenceOutputAssembly="false"
         keeps it off this project's compile and runtime reference set (its System.Environment would otherwise clash
         with the platform's here) and out of this project's output directory. ShadowFixtureAssembly locates the DLL
         by path in the fixture project's own bin/<configuration>/net10.0 and it is read as metadata, never loaded. -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.ShadowFixture\Silvergun.CodeAnalysis.IL.Tests.ShadowFixture.csproj"
                      ReferenceOutputAssembly="false" />
    <!-- Root-class and model-flag fixture for reachability R1, S1 (docs/agent/tasks/reachability-r1.md). Same rules
         as MechanismFixture: a plain reference that copies it (and, transitively, its ...RootFixture.HostStubs) here,
         located BY PATH (RootFixtureAssemblies) and read as metadata, never loaded - it has a [ModuleInitializer]. The
         tests index RootFixture ALONE, so the stubbed host contracts stay external. -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.RootFixture\Silvergun.CodeAnalysis.IL.Tests.RootFixture.csproj" />
  </ItemGroup>

</Project>
