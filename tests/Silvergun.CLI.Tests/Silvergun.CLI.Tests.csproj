<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with Silvergun.CodeAnalysis.IL.Tests (linked, not project-referenced): both suites corrupt one
         method body the same way, and a second copy of the PE offset arithmetic would drift.
         See tests/Shared/FatHeaderPatcher.cs. -->
    <Compile Include="..\Shared\FatHeaderPatcher.cs" Link="Shared\FatHeaderPatcher.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Silvergun.Intel\Silvergun.Intel.csproj" />
    <ProjectReference Include="..\..\src\Silvergun.CLI\Silvergun.CLI.csproj" />
    <!-- A findings-free assembly to analyze end-to-end. Referenced (not merely built) so its dll lands in this
         project's output directory, where UnreadableMethodBodyCliTests copies and corrupts it. Nothing compiles
         against its types — it is located by file name at test time. -->
    <ProjectReference Include="..\Silvergun.CLI.Tests.BenignFixture\Silvergun.CLI.Tests.BenignFixture.csproj" />
    <!-- Real IndicatorAnalysis findings across every IndicatorCategory (indicator-cli-integration task), reused
         from the IL test suite's own fixture (tests/Silvergun.CodeAnalysis.IL.Tests.Fixture/IndicatorPayloads.cs)
         rather than duplicating a second copy: referenced (not merely built) so its dll lands in this project's
         output directory and IndicatorHeadlineAndJsonEndToEndTests can drive the real CLI against it by file name. -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.Fixture\Silvergun.CodeAnalysis.IL.Tests.Fixture.csproj" />
    <!-- The stand-in `yara` binary of the NuGet suite (an Exe, so a ProjectReference copies its apphost here). Used by
         YaraIncompleteScanCliTests to drive a real `scan-package` child process into an INCOMPLETE YARA scan that
         still found hits (ADR 0032) — the only way to observe the stderr advisory and the end-to-end exit codes,
         both of which live inline in Program.RunScanPackage. Nothing compiles against its types. -->
    <ProjectReference Include="..\Silvergun.PackageAnalysis.NuGet.Tests.FakeYaraProbe\Silvergun.PackageAnalysis.NuGet.Tests.FakeYaraProbe.csproj" />
  </ItemGroup>

</Project>
