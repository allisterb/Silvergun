<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The cross-platform suite is net10.0 and is validated on Linux/WSL; it must stay the ONLY TFM there.
         On Windows we ALSO build net10.0-windows so the #if WINDOWS YARA backends are reachable by a test at all:
         the default, the out-of-process YaraXWorkerScanner and its YARA-X binding (ADR 0033), and the in-process
         LibYaraScanner (ADR 0028), now only an explicit fallback (SILVERGUN_YARA_ENGINE=libyara). The
         poisoned-compiler defect that ADR 0028 fixes was invisible to 70 Yara-named tests precisely because
         that type is absent from the net10.0 build. Everything net10.0-windows-only lives behind #if WINDOWS
         (see LibYaraScannerPoisoningTests.cs), so the net10.0 build is byte-for-byte the suite it always was. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net10.0-windows</TargetFrameworks>
    <!-- libyara.NET is a mixed-mode C++/CLI assembly with a native win-x64 payload: a RID-less (AnyCPU) test
         host CANNOT load it. Pinning the RID on the inner net10.0-windows build (same reason as the
         out-of-process YARA probe, docs/agent/tasks/yara-inprocess-timing-probe.md) makes a plain
         `dotnet test` work as well as an explicit `-r win-x64`; the net10.0 build stays RID-less and
         portable. -->
    <RuntimeIdentifier Condition="'$(TargetFramework)' == 'net10.0-windows'">win-x64</RuntimeIdentifier>
    <!-- A bare `dotnet test` on a multi-targeted test project dispatches one VSTest run PER TFM and, by
         default, runs them CONCURRENTLY. The inner dispatch passes VSTestNoBuild=true, so what collides is
         two concurrent TEST HOSTS over the same output — not the CS2012 build collision CLAUDE.md describes
         for two parallel `dotnet test` invocations. It was observed here once as a run that silently
         discovered 12 of 426 tests and still reported "Passed!". This is the knob the SDK added for exactly
         that; BuildInParallel=false would also serialize ProjectReference builds and DispatchToInnerBuilds,
         which is not needed. Prefer the explicit per-TFM commands anyway:
           dotnet test <csproj> -f net10.0
           dotnet test <csproj> -f net10.0-windows -r win-x64 -->
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared with Silvergun.CodeAnalysis.IL.Tests (linked, not project-referenced): the one way a test observes
         Runtime.Warn, so no test swaps the process-global Runtime.logger itself. See tests/Shared/WarningCapture.cs. -->
    <Compile Include="..\Shared\WarningCapture.cs" Link="Shared\WarningCapture.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Silvergun.Intel\Silvergun.Intel.csproj" />
    <ProjectReference Include="..\..\src\Silvergun.PackageAnalysis.NuGet\Silvergun.PackageAnalysis.NuGet.csproj" />
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.Fixture\Silvergun.CodeAnalysis.IL.Tests.Fixture.csproj" />
    <!-- The CHA mechanism fixture and (transitively) its Dependency, for PackageGraphsTests (A2Multi S1): staged into
         test packages as one lib/<tfm> folder so the CrossAssembly path must join the two. A plain reference only so
         both DLLs are copied next to this test assembly; they are located BY PATH and read through PackageGraphs /
         AssemblyDisassembler, never loaded by the test host (the fixture has a [ModuleInitializer]). -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Tests.MechanismFixture\Silvergun.CodeAnalysis.IL.Tests.MechanismFixture.csproj" />
    <!-- Exe, so a plain ProjectReference copies its apphost next to this test assembly (the same mechanism
         Silvergun.CodeAnalysis.IL.Tests uses for its child-process probes). The ADR 0029 fail-closed tests
         spawn it two ways: as a stand-in `yara` binary that misbehaves on demand — which is what makes
         "exited non-zero" and "outlived its timeout" testable on Windows as well as Linux — and as an
         out-of-process host for YaraCliScanner, so the ruleset-preparation failure can be induced by
         poisoning one process's temp directory instead of the whole test run's. -->
    <ProjectReference Include="..\Silvergun.PackageAnalysis.NuGet.Tests.FakeYaraProbe\Silvergun.PackageAnalysis.NuGet.Tests.FakeYaraProbe.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- The YARA-X binding's child-process fixture (ADR 0033 T2, Windows only like the binding): YaraXNative.TryLoad is
         decided by its first call per process, so the missing-DLL and resolver tests (YaraXNativeLoadTests) each start
         a fresh one. An Exe, so this copies its apphost next to the net10.0-windows test assembly. -->
    <ProjectReference Include="..\Silvergun.PackageAnalysis.NuGet.Tests.YaraXProbe\Silvergun.PackageAnalysis.NuGet.Tests.YaraXProbe.csproj" />
    <!-- The net10.0-windows CLI (amendment (m) of docs/agent/tasks/yarax-worker.md): Silvergun.CLI.Tests builds net10.0
         only, where `__worker yara` correctly answers `fatal` "engine unavailable on this platform", so the real-engine
         verb tests (YaraWorkerVerbWindowsTests) live here. An Exe, so this copies Silvergun.CLI.exe and its dependencies
         next to the net10.0-windows test assembly. That also makes YaraXWorkerScanner's production constructor resolve
         its worker by amendment (o) step 2 (the apphost in AppContext.BaseDirectory) under testhost, which
         YaraXWorkerScannerTests pins. ProjectReference only: no packages. -->
    <ProjectReference Include="..\..\src\Silvergun.CLI\Silvergun.CLI.csproj" />
    <!-- The startup hook that lists a CLI child's loaded assemblies and native modules (see that project): the windows
         CLI's worker mode must load yara_x_capi.dll, and its normal scan-package must never load it (ADR 0033 FINAL FORM
         decision 5). Referenced only so its dll lands here; nothing compiles against it. -->
    <ProjectReference Include="..\Silvergun.CLI.Tests.LoadedAssembliesHook\Silvergun.CLI.Tests.LoadedAssembliesHook.csproj" />
  </ItemGroup>

</Project>
