<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Silvergun.CodeAnalysis.IL\Silvergun.CodeAnalysis.IL.csproj" />
    <!-- Referenced for its NuGet.Protocol / NuGet.Packaging package references only (the harness downloads and
         opens .nupkg files); no Silvergun.Intel type is used. Deliberately NOT a new PackageReference - the task
         forbids adding NuGet packages, and Silvergun.Intel already carries exactly the ones needed. -->
    <ProjectReference Include="..\..\src\Silvergun.Intel\Silvergun.Intel.csproj" />
    <!-- Reachability R2 (docs/agent/tasks/reachability-r2.md): NuGetPackage.Open and PackageGraphs.Build for the
         offline reachability mode. A project, not a package; it resolves to its net10.0 flavour. -->
    <ProjectReference Include="..\..\src\Silvergun.PackageAnalysis.NuGet\Silvergun.PackageAnalysis.NuGet.csproj" />
    <!-- Graph worker S3 (docs/agent/tasks/graph-worker.md, the worker-parity mode): an Exe, so this copies the CLI apphost and its
         dependencies next to the harness, where PackageReachability.Analyze resolves its graph worker (the apphost in
         AppContext.BaseDirectory). It resolves to the CLI's net10.0 flavour; nothing compiles against it. ProjectReference
         only: no packages. -->
    <ProjectReference Include="..\..\src\Silvergun.CLI\Silvergun.CLI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pinned corpus. Lives in the repo (it IS the experiment definition); the .nupkg files it names are
         cached outside the repo and never committed. -->
    <Content Include="benign-corpus.manifest" CopyToOutputDirectory="PreserveNewest" />
    <!-- Corpus data lives in data/corpus; each is linked so it still lands next to the executable, where the defaults look. -->
    <!-- The 2026-08-21 P-lib presence baseline as data, R2's regression oracle; its header names its source. -->
    <Content Include="..\..\data\corpus\presence-oracle-2026-08-21.tsv" Link="presence-oracle-2026-08-21.tsv" CopyToOutputDirectory="PreserveNewest" />
    <!-- R2b's regression oracle (the S2 map), the oracle option's default; its header names its source. -->
    <Content Include="..\..\data\corpus\presence-oracle-2026-11-06.tsv" Link="presence-oracle-2026-11-06.tsv" CopyToOutputDirectory="PreserveNewest" />
    <!-- R2b S3's build-time corpus, the combine mode's default C-build manifest; provenance in data/corpus/c-build.provenance.md. -->
    <Content Include="..\..\data\corpus\c-build.manifest" Link="c-build.manifest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
