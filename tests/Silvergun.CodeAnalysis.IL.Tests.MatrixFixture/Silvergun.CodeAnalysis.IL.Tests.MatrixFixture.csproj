<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The analysis matrix: the oldest .NET Framework we expect to scan, and current .NET.
         net8.0 was DROPPED on purpose — it defines both NET5_0_OR_GREATER and NET7_0_OR_GREATER, so its
         guarded shape set is identical to net10.0's (measured: same counts, byte-identical assembly size),
         i.e. pure duplication for interop coverage. See docs/agent/tasks/tfm-matrix-tests.md
         ("Decision — drop net8.0") for the criteria that would put it (or net9.0) back. -->
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Required by the [LibraryImport] source generator (SYSLIB1062): it emits the P/Invoke stub as
         `unsafe` unconditionally, even for a fully blittable signature. Not our own pointer use. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
