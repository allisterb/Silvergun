<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted (ADR 0016): net10.0-windows hosts the libyara.NET in-process YARA backend
         (#if WINDOWS); the plain net10.0 build stays libyara-free and Linux-loadable. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows'">
    <!-- The YARA-X C API binding (Yara/YaraX, #if WINDOWS; ADR 0033) uses source-generated [LibraryImport] P/Invoke,
         pointers and unmanaged callbacks, which require unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net10.0-windows' And Exists('$(MSBuildThisFileDirectory)..\..\artifacts\tools\yara-x-capi\win-x64\yara_x_capi.dll')">
    <!-- The pinned YARA-X C API DLL, Silvergun's source build (release yara-x-capi-v1.22.0; installed and verified by
         build/fetch-yara.ps1 -Engine YaraXCapi; ADR 0033), copied next to the assembly so YaraXNative loads it from the
         application directory. CopyToOutputDirectory makes it flow to every referencing project's output (the CLI, the
         tests). Not a NuGet dependency. Absent DLL => not copied => the worker reports "engine unavailable". -->
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\tools\yara-x-capi\win-x64\yara_x_capi.dll" Link="yara_x_capi.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net10.0' And $([MSBuild]::IsOSPlatform('Linux')) And Exists('$(MSBuildThisFileDirectory)..\..\artifacts\tools\yara-x-capi\linux-x64\libyara_x_capi.so')">
    <!-- The Linux counterpart (fetch-yara.ps1 -Engine YaraXCapi -Platform linux-x64), copied only when building on Linux.
         Nothing loads it yet: the YARA-X worker is #if WINDOWS until its Linux port (ADR 0033 decision 5). -->
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\tools\yara-x-capi\linux-x64\libyara_x_capi.so" Link="libyara_x_capi.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL\Silvergun.CodeAnalysis.IL.csproj" />
    <!-- SSA facts in the graph worker (ADR 0038, S4.4): a project reference, run only inside the worker process. -->
    <ProjectReference Include="..\Silvergun.CodeAnalysis.IL.Ssa\Silvergun.CodeAnalysis.IL.Ssa.csproj" />
    <ProjectReference Include="..\Silvergun.Intel\Silvergun.Intel.csproj" />
    <ProjectReference Include="..\Silvergun.Runtime\Silvergun.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OSSGadget MIT backdoor rulesets (see Resources/BackdoorRules/NOTICE.md), loaded at runtime by ScriptRuleScanner. -->
    <EmbeddedResource Include="Resources\BackdoorRules\*.json" />
    <EmbeddedResource Include="Resources\BackdoorRules\NOTICE.md" />
    <!-- Silvergun-owned rulesets (see Resources/SilvergunRules/README.md), loaded at runtime by ScriptRuleScanner. -->
    <EmbeddedResource Include="Resources\SilvergunRules\*.json" />
    <EmbeddedResource Include="Resources\SilvergunRules\README.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- ReversingLabs MIT YARA rules embedded BY LINK from the ext/ submodule (ADR 0016, see
         Resources/YaraRules/NOTICE.md); never copied into src/. The Link keeps the submodule's
         category folders in each manifest resource name, so names stay unique and stable. -->
    <EmbeddedResource Include="..\..\ext\reversinglabs-yara-rules\yara\**\*.yara">
      <Link>Resources\YaraRules\ReversingLabs\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <!-- Our own YARA rules, compiled alongside the ReversingLabs set. -->
    <EmbeddedResource Include="Resources\YaraRules\Custom\**\*.yara" />
    <EmbeddedResource Include="Resources\YaraRules\NOTICE.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CST.ApplicationInspector.RulesEngine" Version="1.10.2" />
    <!-- Windows-only: mixed-mode C++/CLI wrapper over native libyara 4.5 (win-x64/win-arm64 only).
         Conditioned to net10.0-windows so the net10.0 (Linux) artifact never references libyara. -->
    <PackageReference Include="Microsoft.O365.Security.Native.libyara.NET.Core" Version="4.5.5" Condition="'$(TargetFramework)'=='net10.0-windows'" />
    <PackageReference Include="NuGet.LibraryModel" Version="7.9.0" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="NuGet.ProjectModel" Version="7.9.0" />
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <PackageReference Include="Microsoft.CST.RecursiveExtractor" Version="1.2.61" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

</Project>
